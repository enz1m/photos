<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="image/heif-sequence">
    <glob pattern="*.heics"/>
    <glob pattern="*.heifs"/>
  </mime-type>
  <mime-type type="image/vnd.adobe.photoshop">
    <glob pattern="*.psb"/>
  </mime-type>
  <mime-type type="image/x-pentax-pef">
    <glob pattern="*.ptx"/>
  </mime-type>
  <mime-type type="image/x-portable-arbitrarymap">
    <comment>Portable arbitrary map</comment>
    <sub-class-of type="image/x-portable-anymap"/>
    <glob pattern="*.pam"/>
    <magic priority="50"><match type="string" offset="0" value="P7\n"/></magic>
  </mime-type>
</mime-info>
